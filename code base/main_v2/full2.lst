 257:full2.c       **** 		uint8_t hand_detected = 0;
 258:full2.c       **** 
 259:full2.c       **** 		// Wait 3 minutes for hand detection
 260:full2.c       **** 		while (timeout < 1800) { // 3 min ≈ 1800 * 100ms
 261:full2.c       **** 		    distance = ultrasonic_read();
 262:full2.c       **** 		    if (distance > 2 && distance < 15) {
 263:full2.c       **** 		        hand_detected = 1;
 264:full2.c       **** 		        servo_lower_angle(180);
 265:full2.c       **** 		        _delay_ms(2000);
 266:full2.c       **** 		        servo_lower_angle(0);
 267:full2.c       **** 		        _delay_ms(2000);
 268:full2.c       **** 		        servo_upper_angle(180);
 269:full2.c       **** 		        _delay_ms(2000);
 270:full2.c       **** 		        servo_upper_angle(0);
 271:full2.c       **** 		        lcd_goto(2, 0);
 272:full2.c       **** 		        lcd_printf("Hand Detected");
 273:full2.c       **** 		        break;
 274:full2.c       **** 		    }
 275:full2.c       **** 		    _delay_ms(100);
 276:full2.c       **** 		    timeout++;
 277:full2.c       **** 		}
 278:full2.c       **** 
 279:full2.c       **** 		if (!hand_detected) {
 280:full2.c       **** 		    lcd_goto(2, 0);
 281:full2.c       **** 		    lcd_printf("No Hand Action");
 282:full2.c       **** 
 283:full2.c       **** 		    // Immediately do lower + upper actions
 284:full2.c       **** 		    servo_lower_angle(180);
 285:full2.c       **** 		    _delay_ms(2000);
 286:full2.c       **** 		    servo_lower_angle(0);
 287:full2.c       **** 		    _delay_ms(2000);
 288:full2.c       **** 
 289:full2.c       **** 		    servo_upper_angle(180);
 290:full2.c       **** 		    _delay_ms(2000);
 291:full2.c       **** 		    servo_upper_angle(0);
 292:full2.c       **** 		}
 293:full2.c       **** 
 294:full2.c       **** 		buzzer_off();
 295:full2.c       **** 		lcd_goto(2, 0);
 296:full2.c       **** 		lcd_printf("                ");
 297:full2.c       **** 	    }
