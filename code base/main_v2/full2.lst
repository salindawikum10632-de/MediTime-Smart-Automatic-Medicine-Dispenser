 250:full2.c       **** 
 251:full2.c       **** 		buzzer_on();
 252:full2.c       **** 		lcd_goto(2, 0);
 253:full2.c       **** 		lcd_printf("Alarm1: Waiting");
 254:full2.c       **** 
 255:full2.c       **** 		uint16_t distance;
