   7:gsm.c         **** // ---------------- GSM Initialization ----------------
   8:gsm.c         **** void gsm_init(void (*sendByte_func)(unsigned char c), int (*getByte_func)(void)) {
   9:gsm.c         ****     gsm_send_byte = sendByte_func;
  10:gsm.c         ****     gsm_get_byte = getByte_func;
  11:gsm.c         **** 
  12:gsm.c         ****     lcd_clear();
  13:gsm.c         ****     lcd_puts("GSM Init...");
  14:gsm.c         ****     _delay_ms(500);
  15:gsm.c         **** 
  16:gsm.c         ****     // Basic AT test
  17:gsm.c         ****     if (gsm_command_response("AT", "OK", 2000))
  18:gsm.c         ****         lcd_puts("AT OK");
  19:gsm.c         ****     else
  20:gsm.c         ****         lcd_puts("AT Fail");
  21:gsm.c         ****     _delay_ms(1000);
  22:gsm.c         **** 
  23:gsm.c         ****     // Disable echo
  24:gsm.c         ****     gsm_command_response("ATE0", "OK", 2000);
  25:gsm.c         **** 
  26:gsm.c         ****     // Set SMS text mode
  27:gsm.c         ****     gsm_text_sms();
  28:gsm.c         **** }
