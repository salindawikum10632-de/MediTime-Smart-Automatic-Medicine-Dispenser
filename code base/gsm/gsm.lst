  41:gsm.c         **** // ---------------- Send AT Command and wait for response ----------------
  42:gsm.c         **** int gsm_command_response(char *command, char *expected, uint16_t timeout_ms) {
  43:gsm.c         ****     char line[64];
  44:gsm.c         ****     uint16_t t = 0;
  45:gsm.c         **** 
  46:gsm.c         ****     gsm_command(command);
  47:gsm.c         **** 
  48:gsm.c         ****     while (t < timeout_ms) {
  49:gsm.c         ****         if (gsm_readline(line, sizeof(line))) {
  50:gsm.c         ****             lcd_clear();
  51:gsm.c         ****             lcd_puts(line);  // debug on LCD
  52:gsm.c         ****             if (strstr(line, expected)) return 1; // Expected response received
  53:gsm.c         ****         }
  54:gsm.c         ****         _delay_ms(50);
  55:gsm.c         ****         t += 50;
  56:gsm.c         ****     }
  57:gsm.c         **** 
  58:gsm.c         ****     lcd_clear();
  59:gsm.c         ****     lcd_puts("No Resp");
  60:gsm.c         ****     return 0; // timeout
  61:gsm.c         **** }
  62:gsm.c         **** 
  63:gsm.c         **** // ---------------- Set Text SMS Mode ----------------
  64:gsm.c         **** void gsm_text_sms(void) {
  65:gsm.c         ****     gsm_command_response("AT+CMGF=1", "OK", 2000);
  66:gsm.c         **** }
